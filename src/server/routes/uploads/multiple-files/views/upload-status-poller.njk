{% extends 'layouts/uploads.njk' %}

{% block head %}
  {{ super() }}
  <meta http-equiv="refresh" content="1">
{% endblock %}

{% block pageHeading %}
  {{ appHeading({
    text: heading,
    caption: "Virus check."
  }) }}
{% endblock %}

{% block example %}
  <p>
    Your files are currently being checked for viruses {{ appLoader({ classes: "app-loader--is-loading" }) }}
  </p>
{% endblock %}

{% block developerNotes %}
  {{ appDeveloperNotes({
    sections: [
      {
        heading: "Before this page",
        items: [
          "cdp-uploader received the form and redirected the browser here.",
          { html: "We called the <code>statusUrl</code> saved in the <code>creatures</code> session (cdp-uploader <code>GET /status/{uploadId}</code>). It is not <code>ready</code> yet." }
        ]
      },
      {
        heading: "What happens next",
        items: [
          { html: "A <code>&lt;meta http-equiv=\"refresh\"&gt;</code> reloads this page every second, which calls <code>/status</code> again." },
          { html: "When <code>ready</code>, the <code>form</code> from <code>/status</code> is validated with Joi like a normal POST: required fields, the CSRF <code>crumb</code>, and each file's <code>hasError</code>." },
          { html: "Errors send you back to the form with a message per field. Otherwise the fields are saved in the session under the <code>creatureId</code> and you go to Summary." }
        ]
      }
    ],
    payloadHeading: "Latest /status response",
    payload: status,
    code: [
      "src/server/routes/uploads/multiple-files/controllers/upload-status-poller.js",
      "src/server/routes/uploads/multiple-files/helpers/schemas/upload-form-validation.js"
    ],
    docs: {
      text: "cdp-uploader GET /status",
      href: "https://github.com/DEFRA/cdp-uploader?tab=readme-ov-file#get-statusuploadid"
    }
  }) }}
{% endblock %}
